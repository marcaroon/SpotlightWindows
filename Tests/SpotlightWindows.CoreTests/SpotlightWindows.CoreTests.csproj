<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free test runner for the pure logic in Core/ (scoring + orchestration).
    Targets plain net10.0 on purpose: it links the Core source files directly and replaces the one WPF
    type they touch (ImageSource) with a stub, so it runs anywhere with `dotnet run` — no NuGet, no Windows.
    It does NOT cover WPF UI, Win32 interop, COM or the Windows Search OLE DB query.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpotlightWindows.CoreTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Core\Models\SearchResult.cs" Link="Core\SearchResult.cs" />
    <Compile Include="..\..\Core\Models\SearchSnapshot.cs" Link="Core\SearchSnapshot.cs" />
    <Compile Include="..\..\Core\Interfaces\ISearchProvider.cs" Link="Core\ISearchProvider.cs" />
    <Compile Include="..\..\Core\Interfaces\IProgressiveSearchProvider.cs" Link="Core\IProgressiveSearchProvider.cs" />
    <Compile Include="..\..\Core\Services\LoggingService.cs" Link="Core\LoggingService.cs" />
    <Compile Include="..\..\Core\Services\SearchOrchestrator.cs" Link="Core\SearchOrchestrator.cs" />
    <Compile Include="..\..\Core\Services\TextMatchScorer.cs" Link="Core\TextMatchScorer.cs" />
    <Compile Include="..\..\Core\Services\FileMatchScorer.cs" Link="Core\FileMatchScorer.cs" />
  </ItemGroup>

</Project>
