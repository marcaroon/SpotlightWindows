<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Application metadata -->
    <RootNamespace>SpotlightWindows</RootNamespace>
    <AssemblyName>SpotlightWindows</AssemblyName>
    <Version>0.1.0</Version>
    <Description>A fast, keyboard-first launcher and search utility for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for querying Windows Search Index via OLE DB -->
    <PackageReference Include="System.Data.OleDb" Version="9.0.*" />
  </ItemGroup>

</Project>
