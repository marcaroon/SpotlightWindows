<Window x:Class="SpotlightWindows.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Spotlight"
        Height="480" Width="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Color x:Key="AccentColor">#8DB4FF</Color>
        <Color x:Key="AccentSoftColor">#C9D8FF</Color>
        <Color x:Key="PanelDarkColor">#15181F</Color>
        <Color x:Key="PanelMidColor">#1B212C</Color>
        <Color x:Key="GlassColor">#CF1D2431</Color>
        <Color x:Key="GlassStrokeColor">#40FFFFFF</Color>
        <Color x:Key="TextPrimaryColor">#F4F7FF</Color>
        <Color x:Key="TextSecondaryColor">#B7C1D8</Color>
        <Color x:Key="SurfaceColor">#2D3340</Color>
        <Color x:Key="HoverColor">#33FFFFFF</Color>
        <Color x:Key="SelectedColor">#3D75B9FF</Color>

        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="{StaticResource PanelDarkColor}"/>
        <SolidColorBrush x:Key="PanelMidBrush" Color="{StaticResource PanelMidColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}"/>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="12"
                                Padding="12,10"
                                Margin="4,2"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7CA8FF"/>
                                <Setter TargetName="ItemBorder" Property="Padding" Value="11,9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border Margin="18">
        <Border CornerRadius="28"
                BorderThickness="1"
                BorderBrush="#4DFFFFFF"
                Background="#A014161D">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40"
                                  ShadowDepth="16"
                                  Opacity="0.42"
                                  Color="#000000"/>
            </Border.Effect>

            <Border CornerRadius="28" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Rectangle Grid.RowSpan="2" Fill="#40FFFFFF" Height="120" VerticalAlignment="Top">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <Border Grid.Row="0"
                            x:Name="SearchPanelBorder"
                            Background="#B3293039"
                            CornerRadius="18"
                            Margin="14,14,14,0"
                            Padding="14,12,14,12"
                            BorderBrush="#50FFFFFF"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="28" Height="28"
                                    CornerRadius="9"
                                    Background="#7EA8FF"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    BorderBrush="#B7D0FF"
                                    BorderThickness="0.5">
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Column="1">
                                <TextBlock x:Name="WatermarkText"
                                           Text="Search"
                                           FontSize="22"
                                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                           FontWeight="Light"
                                           Foreground="#AAB6D3"
                                           VerticalAlignment="Center"
                                           Padding="0,4"
                                           IsHitTestVisible="False"/>

                                <TextBox x:Name="SearchTextBox"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         TextChanged="SearchTextBox_TextChanged"/>
                            </Grid>

                            <Border Grid.Column="2"
                                    Background="#38FFFFFF"
                                    CornerRadius="8"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    BorderBrush="#60FFFFFF"
                                    BorderThickness="1">
                                <TextBlock Text="Esc"
                                           FontSize="10.5"
                                           FontFamily="Segoe UI, sans-serif"
                                           Foreground="#EEF3FF"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="ResultsPanelBorder"
                            Grid.Row="1"
                            Background="#B3293039"
                            CornerRadius="0,0,18,18"
                            Margin="14,8,14,14"
                            Padding="0,4,0,0"
                            BorderBrush="#50FFFFFF"
                            BorderThickness="1,0,1,1"
                            Visibility="Collapsed"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="EmptyStatePanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,18,0,18"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="EmptyStateIcon"
                                           Text="&#xE773;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="28"
                                           Foreground="#D9E7FF"
                                           HorizontalAlignment="Center"
                                           Opacity="0.75"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="EmptyStateText"
                                           Text="Start typing to search..."
                                           FontSize="14"
                                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                           Foreground="#C8D0EA"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ListBox x:Name="ResultsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Visibility="Collapsed"
                                     MaxHeight="360"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     ItemContainerStyle="{StaticResource ResultListBoxItemStyle}"
                                     SelectionChanged="ResultsListBox_SelectionChanged"
                                     MouseDoubleClick="ResultsListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Source="{Binding IconSource}"
                                                   Width="28" Height="28"
                                                   Margin="0,0,12,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="11.5"
                                                           FontFamily="Segoe UI, sans-serif"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="#37FFFFFF"
                                                    CornerRadius="6"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0"
                                                    BorderBrush="#5AFFFFFF"
                                                    BorderThickness="1"
                                                    Opacity="0.9">
                                                <TextBlock Text="{Binding ResultType}"
                                                           FontSize="10"
                                                           FontFamily="Segoe UI, sans-serif"
                                                           Foreground="#EBF0FF"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Border>
</Window>
